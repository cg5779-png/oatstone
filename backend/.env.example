# 환경: local(기본) → SQLite / production|server → PostgreSQL
APP_ENV=local

# DATABASE_URL 을 지정하면 APP_ENV보다 우선합니다.
DATABASE_URL=sqlite:///./oatstone.db

# 서버(PostgreSQL) 예시 — APP_ENV=production 이면 DATABASE_URL 없이도 아래 값으로 연결
# APP_ENV=production
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=oatstone
# POSTGRES_USER=oatstone
# POSTGRES_PASSWORD=change-me
# POSTGRES_SSLMODE=require
# 또는
# DATABASE_URL=postgresql+psycopg://oatstone:change-me@127.0.0.1:5432/oatstone

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# 문의 수신 이메일
INQUIRY_RECIPIENT=oootn@naver.com

# 네이버 메일 SMTP (네이버 > 환경설정 > POP3/IMAP > SMTP 사용 설정)
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=oootn@naver.com
SMTP_PASSWORD=your_naver_app_password
SMTP_FROM=oootn@naver.com

# 관리자 로그인 (반드시 실제 값으로 교체할 것 — 아래는 예시일 뿐 로그인에 쓸 수 없음)
# JWT_SECRET 생성: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me
JWT_EXPIRE_HOURS=12
